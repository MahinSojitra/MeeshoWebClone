@model MeeshoWebClone.Areas.Admin.ViewModels.ProductCategoryCreateViewModel

@{
    ViewData["Title"] = "Add Category";
}

<div class="container mt-4">
    <div class="card p-3 mx-auto" style="max-width: 500px;">
        <div class="card-header">
            <h5 class="text-center mb-0">Add New Category</h5>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">

                <div class="row">
                    <!-- Category Name -->
                    <div class="col-md-12 mb-3">
                        <div class="form-floating">
                            <input type="text" class="form-control" asp-for="Name" placeholder="Category Name" required>
                            <label>Category Name</label>
                        </div>
                        <span class="text-danger error-font fw-normal" asp-validation-for="Name"></span>
                    </div>
                </div>

                <div class="row align-content-between">
                    <div class="col">
                        <button type="submit" class="btn btn-success fw-bold">Add Category</button>
                    </div>
                    <div class="col text-end">
                        <a asp-action="Index" class="btn btn-light fw-bold border border-1">Back</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}