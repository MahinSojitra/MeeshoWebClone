@model MeeshoWebClone.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
    var inStockItems = Model?.Items?.Where(x => x.StockQuantity > 0).ToList() ?? new();
    decimal subtotal = inStockItems.Sum(x => x.Quantity * (x.DiscountedPrice > 0 ? x.DiscountedPrice : x.Price));
    decimal gstAmount = subtotal * 0.18m;
    decimal totalAmount = subtotal + gstAmount;
}

<div class="container mt-4">
    <h3 class="mb-3 fw-bold">
        <i class="bi bi-bag-check"></i> Checkout
    </h3>

    @if (!inStockItems.Any())
    {
        <div class="d-flex justify-content-center align-items-center bg-light rounded" style="height: 300px;">
            <p class="text-muted text-center" style="font-size: 1rem;">
                No items in stock available for checkout.
            </p>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Checkout Items -->
            <div class="col-lg-8 col-md-12">
                @foreach (var item in inStockItems)
                {
                    <div class="list-group-item p-3 border rounded shadow-sm mb-3">
                        <div class="d-flex flex-column flex-md-row">
                            <img src="data:image/png;base64,@Convert.ToBase64String(item.FirstImage)"
                                 class="img-thumbnail me-md-3 mb-2 mb-md-0"
                                 style="width: 100px; height: 100px; object-fit: cover;" />
                            <div class="flex-grow-1">
                                <h5 class="mb-1 text-truncate" style="max-width: 550px;">@item.Name</h5>
                                <p class="mb-1 text-muted small text-truncate" style="max-width: 550px;">@item.Description</p>
                                <div class="d-flex flex-column mb-2">
                                    @if (item.DiscountPercentage > 0)
                                    {
                                        <p class="fw-bold text-danger mb-0" style="font-size: 1.3rem;">
                                            ₹@item.DiscountedPrice
                                            <small class="text-muted fw-light" style="font-size: 0.9rem;">
                                                (@item.DiscountPercentage% OFF)
                                            </small>
                                        </p>
                                        <small class="text-muted" style="text-decoration: line-through;">₹@item.Price</small>
                                    }
                                    else
                                    {
                                        <p class="fw-bold text-dark" style="font-size: 1.3rem;">₹@item.Price</p>
                                    }
                                </div>
                                <hr class="mt-2 mb-2" />
                                <div class="text-end">
                                    <span class="badge bg-light text-success border border-1">
                                        @item.Quantity @((item.Quantity == 1) ? "Unit" : "Units")
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Order Summary + Payment Form -->
            <div class="col-lg-4 col-md-12">
                <form asp-action="OrderConfirmation" method="post">
                    @Html.AntiForgeryToken()

                    <div class="card shadow-sm p-3">
                        <h5 class="fw-bold mb-2">Order Summary</h5>
                        <hr class="my-1" />
                        <p class="d-flex justify-content-between mb-2 mt-2">
                            <span>Total Items:</span>
                            <strong>@inStockItems.Sum(x => x.Quantity)</strong>
                        </p>
                        <p class="d-flex justify-content-between mb-1">
                            <span>Subtotal:</span>
                            <strong>₹@subtotal</strong>
                        </p>
                        <hr class="my-1" />
                        <p class="d-flex justify-content-between text-success mb-0">
                            <span>GST (18%):</span>
                            <strong>₹@gstAmount</strong>
                        </p>
                        <hr class="my-1" />
                        <p class="d-flex justify-content-between fw-bold text-success">
                            <span>Total Amount:</span>
                            <strong>₹@totalAmount</strong>
                        </p>
                        <hr class="my-2" />

                        <!-- Payment Methods -->
                        <h5 class="fw-bold mb-2">Select Payment Method</h5>

                        <input type="hidden" asp-for="Payment.SelectedMethod" id="selectedMethod" />

                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="creditCard" value="creditCard" onclick="togglePaymentFields()">
                            <label class="form-check-label" for="creditCard">
                                <i class="bi bi-credit-card"></i> Credit/Debit Card
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="upi" value="upi" onclick="togglePaymentFields()">
                            <label class="form-check-label" for="upi">
                                <i class="bi bi-upc"></i> UPI
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="cod" value="cod" checked onclick="togglePaymentFields()">
                            <label class="form-check-label" for="cod">
                                <i class="bi bi-cash"></i> Cash on Delivery
                            </label>
                        </div>

                        <!-- Credit/Debit Card Fields -->
                        <div id="cardDetails" class="mt-3">
                            <label asp-for="Payment.CardNumber" class="form-label d-block"></label>
                            <input asp-for="Payment.CardNumber" class="form-control" placeholder="Enter Card Number" />
                            <span asp-validation-for="Payment.CardNumber" class="text-danger d-block error-font fw-normal"></span>

                            <label asp-for="Payment.CardHolderName" class="form-label d-block mt-2"></label>
                            <input asp-for="Payment.CardHolderName" class="form-control" placeholder="Enter Card Holder Name" />
                            <span asp-validation-for="Payment.CardHolderName" class="text-danger d-block error-font fw-normal"></span>

                            <label asp-for="Payment.CVV" class="form-label d-block mt-2"></label>
                            <input asp-for="Payment.CVV" class="form-control" placeholder="Enter CVV" />
                            <span asp-validation-for="Payment.CVV" class="text-danger d-block error-font fw-normal"></span>
                        </div>

                        <!-- UPI Field -->
                        <div id="upiDetails" class="mt-3 d-none">
                            <label asp-for="Payment.UPIId" class="form-label"></label>
                            <input asp-for="Payment.UPIId" class="form-control" placeholder="Enter UPI ID" />
                            <span asp-validation-for="Payment.UPIId" class="text-danger d-block error-font fw-normal"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100 mt-3 fw-bold">
                            <i class="bi bi-credit-card"></i> Confirm & Pay
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePaymentFields() {
            const cardDetails = document.getElementById("cardDetails");
            const upiDetails = document.getElementById("upiDetails");
            const selectedMethod = document.getElementById("selectedMethod");

            if (document.getElementById("creditCard").checked) {
                cardDetails.classList.remove("d-none");
                upiDetails.classList.add("d-none");
                selectedMethod.value = "creditCard";
            } else if (document.getElementById("upi").checked) {
                upiDetails.classList.remove("d-none");
                cardDetails.classList.add("d-none");
                selectedMethod.value = "upi";
            } else {
                cardDetails.classList.add("d-none");
                upiDetails.classList.add("d-none");
                selectedMethod.value = "cod";
            }
        }

        document.addEventListener("DOMContentLoaded", togglePaymentFields);
    </script>
}