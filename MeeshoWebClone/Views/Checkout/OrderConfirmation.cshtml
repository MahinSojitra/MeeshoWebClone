@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container mt-5 text-center">
    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
    <h2 class="mt-3 fw-bold">Order Placed.</h2>
    <p class="text-muted">Thank you for shopping with us. We will notify you once your order is shipped.</p>

    <a asp-controller="Home" asp-action="Index" class="btn btn-light text-success border border-1 fw-bold mt-4">
        <i class="bi bi-house-door me-1"></i> Continue Shopping
    </a>
</div>
