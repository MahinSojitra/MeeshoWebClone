@model MeeshoWebClone.ViewModels.OTPViewModel

@{
    ViewBag.Title = "Verify OTP";
    var otpSent = Context.Request.Query["otpSent"];
}

<div class="container mt-5">
    <div class="card p-4 shadow mx-auto" style="max-width: 40%;">
        <h5 class="mb-0 text-center">Phone Login Verification</h5>
        <span class="text-muted text-center d-block">Enter the OTP sent to your email.</span>
        <hr class="mt-2" />

        <form asp-action="VerifyPhoneLoginOtp" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (!string.IsNullOrEmpty(otpSent) && otpSent == "True")
            {
                <div class="alert alert-info small p-2">
                    <i class="bi bi-envelope-check-fill mr-1 ml-2"></i> An OTP has been sent to your registered email address. Please check your inbox.
                </div>
            }

            <div class="mb-3">
                <label asp-for="OTP" class="form-label">Enter 4-digit OTP</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                    <input asp-for="OTP" class="form-control" placeholder="Enter OTP" maxlength="4" />
                </div>
                <span asp-validation-for="OTP" class="text-danger small"></span>
                <small class="text-muted">OTP is valid for 5 minutes</small>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-success w-100">Verify & Login</button>
            </div>

            <div class="text-center mt-2 small">
                <a class="text-decoration-none" asp-controller="Account" asp-action="Login">Back to Login</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
