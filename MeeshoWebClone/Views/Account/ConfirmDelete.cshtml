@{
    ViewBag.Title = "Delete Account";
}

<div class="container mt-5">
    <div class="card shadow-sm p-4 mx-auto" style="max-width: 450px;">
        <h5 class="text-center text-danger mb-0"><i class="bi bi-exclamation-triangle mr-2"></i> Delete Account</h5>
        <hr />
        <p class="text-muted">
            Are you sure you want to <strong class="text-danger">permanently delete</strong> your account?
            This action <strong>cannot</strong> be undone.
        </p>

        <form asp-action="DeleteAccount" asp-controller="Account" method="post">
            <div class="alert alert-warning small px-3 py-2">
                All your data will be erased.
            </div>

            <div class="d-flex justify-content-between">
                <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-success">
                    <i class="bi bi-arrow-left"></i> Cancel
                </a>
                <button type="submit" class="btn btn-sm btn-danger">
                    <i class="bi bi-trash"></i> Confirm Delete
                </button>
            </div>
        </form>
    </div>
</div>