@model MeeshoWebClone.ViewModels.ForgotPasswordViewModel

@{
    ViewBag.Title = "Forgot Password";
    var emailSent = Context.Request.Query["emailSent"];
}

<div class="container mt-5">
    <div class="card p-4 shadow mx-auto" style="max-width: 40%;">
        <h5 class="mb-0 text-center">Forgot Password</h5>
        <span class="text-muted text-center d-block">Enter your email to reset your password.</span>
        <hr class="mt-2" />

        <form asp-action="ForgotPassword" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (!string.IsNullOrEmpty(emailSent) && emailSent == "True")
            {
                <div class="alert alert-success small p-2">
                    <i class="bi bi-check-circle-fill mr-1 ml-2"></i> If an account exists with this email, a password reset link has been sent.
                </div>
            }

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-success w-100">Send Reset Link</button>
            </div>

            <div class="text-center mt-2 small">
                Remember your password?
                <a class="text-decoration-none" asp-controller="Account" asp-action="Login">Login here</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
