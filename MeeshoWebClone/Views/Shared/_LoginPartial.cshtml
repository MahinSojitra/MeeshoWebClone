@using Microsoft.AspNetCore.Identity;
@inject SignInManager<User> _signInManager;
@inject UserManager<User> _userManager;

@{
    var isAuthenticated = _signInManager.IsSignedIn(User);
    var userName = isAuthenticated ? User.Identity!.Name : "Welcome, Guest User";
    var isAdmin = isAuthenticated && User.IsInRole("Admin");
    var isSeller = isAuthenticated && User.IsInRole("Seller");
}

<div class="navbar-nav ml-lg-auto d-flex flex-column flex-lg-row align-items-center">
    <a href="#" class="nav-link h-100 ml-2"><i class="bi bi-phone"></i> Download App</a>
    <span class="divider d-none d-lg-inline"></span>
    <a href="#" class="nav-link">Become a Supplier</a>
    <span class="divider d-none d-lg-inline"></span>
    <a href="#" class="nav-link">Investor Relations</a>

    @if (Context.Request.Path != "/Account/Login" && Context.Request.Path != "/Account/Signup" && Context.Request.Path != "/Account/Verify")
    {
        @if (!isAuthenticated)
        {
            <span class="divider d-none d-lg-inline"></span>
            <div class="signup dropdown">
                <a class="profile-link nav-link d-flex flex-column align-items-center text-decoration-none text-dark" href="#" role="button" id="profileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="bi bi-person icon-size"></i>
                    <span class="small">Profile</span>
                </a>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="profileDropdown">
                    <div class="px-2 py-1">
                        <p class="mb-1 fw-bold">@userName</p>
                        <p class="small text-muted mb-2">To access your account</p>
                        <a class="btn btn-success btn-block d-block sign-up-btn mb-2" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-success btn-block d-block sign-up-btn" asp-controller="Account" asp-action="Signup">Sign Up</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <span class="divider d-none d-lg-inline"></span>
            <div class="signup dropdown">
                <a class="nav-link d-flex flex-column align-items-center text-decoration-none text-dark" href="#" role="button" id="profileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="bi bi-person icon-size"></i>
                    <span class="small">Profile</span>
                </a>
                <div class="dropdown-menu w-auto" aria-labelledby="profileDropdown">
                    <div class="d-flex align-items-center px-2 py-1 align-middle">
                        <img src="~/assets/user-avatar.png" alt="User Avatar" class="rounded-circle" width="50" height="50">
                        <div class="container ms-0">
                            <p class="mb-0 font-weight-bold">
                                Welcome, @(@isSeller ? "Seller" : @isAdmin ? "Admin" : "User")
                            </p>
                            <p class="small text-muted mb-0">@userName</p>
                        </div>
                    </div>

                    @if (isAdmin)
                    {
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item text-success py-2" asp-area="Admin" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i> Admin Panel
                        </a>
                        <a class="dropdown-item text-dark py-2" asp-area="" asp-controller="Like" asp-action="Index">
                            <i class="bi bi-heart me-1"></i> Liked Products
                        </a>
                        <a class="dropdown-item text-dark py-2" asp-area="Admin" asp-controller="User" asp-action="Index">
                            <i class="bi bi-people me-1"></i> User Management
                        </a>
                        <a class="dropdown-item text-dark py-2" asp-area="Admin" asp-controller="Product" asp-action="Index">
                            <i class="bi bi-box-seam me-1"></i> Product Management
                        </a>
                        <a class="dropdown-item text-dark py-2" asp-area="Admin" asp-controller="Category" asp-action="Index">
                            <i class="bi bi-tags me-1"></i> Category Management
                        </a>
                    }
                    else if (isSeller)
                    {
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item text-success py-2" asp-area="Admin" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-shop me-1"></i> Seller Panel
                        </a>
                        <a class="dropdown-item text-dark py-2" asp-area="" asp-controller="Like" asp-action="Index">
                            <i class="bi bi-heart me-1"></i> Liked Products
                        </a>
                        <a class="dropdown-item text-dark py-2" asp-area="Admin" asp-controller="Product" asp-action="Index">
                            <i class="bi bi-box-seam me-1"></i> Manage My Products
                        </a>
                    }
                    else
                    {
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item text-dark py-2" asp-controller="Account" asp-action="Cart">
                            <i class="bi bi-bag me-1"></i> My Orders
                        </a>
                        <a class="dropdown-item text-dark py-2" asp-area="" asp-controller="Like" asp-action="Index">
                            <i class="bi bi-heart me-1"></i> Liked Products
                        </a>
                    }

                    <hr class="my-1" />
                    <a asp-controller="Account" asp-action="ConfirmDelete" class="dropdown-item text-danger py-1">
                        <i class="bi bi-trash me-2"></i> Delete Account
                    </a>
                    <hr class="my-1" />
                    <a asp-controller="Account" asp-action="Logout" class="dropdown-item bg-light text-success border border-2 fw-bold rounded mt-2 py-1">
                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                    </a>
                </div>
            </div>
        }

        if(isAuthenticated)
        {
            <a asp-controller="Cart" asp-action="Index" class="nav-link d-flex flex-column align-items-center text-decoration-none text-dark">
                <i class="bi bi-cart icon-size"></i>
                <span class="small">Cart</span>
            </a>
        } 
        else
        {
            <a asp-controller="Account" asp-action="Login" class="nav-link d-flex flex-column align-items-center text-decoration-none text-dark">
                <i class="bi bi-cart icon-size"></i>
                <span class="small">Cart</span>
            </a>
        }
    }
</div>
