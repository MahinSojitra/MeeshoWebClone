<div class="col-md-4 mb-4 product-card"
     data-category="@Model.CategoryName.ToLower()"
     data-price="@Model.DiscountedPrice"
     data-rating="@Model.Rating">

    <div class="card h-100 shadow-sm d-flex flex-column text-decoration-none text-dark @(Model.StockQuantity == 0 ? "opacity-50 position-relative" : "")">
        <div class="position-relative">
            <img src="data:image/png;base64,@Convert.ToBase64String(Model.FirstImageData)"
                 class="card-img-top img-fluid"
                 alt="@Model.Name"
                 style="height: 200px; object-fit: contain;">

            @if (Model.StockQuantity == 0)
            {
                <div class="position-absolute top-50 start-50 translate-middle text-center">
                    <span class="badge bg-success fs-6 px-3 py-2 shadow">Out of Stock</span>
                </div>
            }

            @if (Model.FreeDelivery)
            {
                <div class="position-absolute top-0 end-0 m-2">
                    <span class="badge bg-success text-white">Free Delivery</span>
                </div>
            }
        </div>

        <div class="card-body d-flex flex-column flex-grow-1">
            <h5 class="card-title text-truncate mb-1 text-muted fw-semibold">@Model.Name</h5>
            <p class="card-title text-truncate mb-1 text-muted small fw-semibold">@Model.Description</p>
            <p class="mb-2">
                @if (Model.DiscountPercentage > 0)
                {
                <p class="fw-bold text-danger mb-0" style="font-size: 1.4rem;">
                    ₹@Model.DiscountedPrice
                    <small class="text-muted fw-light" style="font-size: 0.9rem;">(@Model.DiscountPercentage% OFF)</small>
                </p>
                <small class="text-muted" style="text-decoration: line-through;">₹@Model.Price</small>
                }
                else
                {
                <p class="fw-bold text-dark" style="font-size: 1.4rem;">₹@Model.Price</p>
                }
            </p>

            <div class="d-flex align-items-center mt-auto mb-3">
                <span class="rounded-pill badge bg-success text-white me-2">
                    <i class="bi bi-star-fill"></i> @Model.Rating
                </span>
                <small class="text-muted">(@Model.ReviewCount Reviews)</small>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-auto">
                @if (User.Identity!.IsAuthenticated)
                {
                    <a asp-controller="Like" asp-action="Toggle" asp-route-id="@Model.ProductId"
                       class="text-decoration-none text-danger fs-4">
                        <i class="bi @(Model.IsLikedByCurrentUser ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="text-decoration-none text-danger fs-4">
                        <i class="bi bi-heart"></i>
                    </a>
                }

                <div id="cart-controls-@Model.ProductId">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        @if (Model.StockQuantity == 0)
                        {
                            <button class="btn btn-sm btn-outline-secondary" disabled>
                                <i class="bi bi-cart-x"></i> Out of Stock
                            </button>
                        }
                        else if (Model.CartQuantity > 0)
                        {
                            <div>
                                <a asp-controller="Cart" asp-action="Update" asp-route-id="@Model.ProductId" asp-route-change="-1"
                                   class="btn btn-sm btn-light text-danger border border-2">
                                    <i class="bi bi-dash-lg"></i>
                                </a>
                                <span class="fw-bold mx-2">@Model.CartQuantity</span>
                                <a asp-controller="Cart" asp-action="Update" asp-route-id="@Model.ProductId" asp-route-change="1"
                                   class="btn btn-sm btn-light text-success border border-2">
                                    <i class="bi bi-plus-lg"></i>
                                </a>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Cart" asp-action="Update" asp-route-id="@Model.ProductId" asp-route-change="1"
                               class="btn btn-sm btn-success">
                                <i class="bi bi-cart-plus"></i> Add to Cart
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-success">
                            <i class="bi bi-cart-plus"></i> Add to Cart
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>