@model MeeshoWebClone.ViewModels.ProductPageViewModel
@{
    ViewData["Title"] = "Home";
}


<div class="container mt-4 px-0">
    <!-- Sorting Dropdown -->
    @await Html.PartialAsync("_SortingDropdown")

    <div class="row mt-3">
        <!-- Filters Sidebar -->
        @await Html.PartialAsync("_FilterSidebar", Model.Categories)

        <!-- Product Grid -->
        @await Html.PartialAsync("_ProductGrid", Model)
    </div>
</div>
