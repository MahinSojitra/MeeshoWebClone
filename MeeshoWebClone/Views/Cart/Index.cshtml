@model List<MeeshoWebClone.ViewModels.CartItemViewModel>

@{
    ViewData["Title"] = "My Cart";
    var inStockItems = Model.Where(x => x.StockQuantity > 0).ToList();
}

<div class="container mt-4">
    <h3 class="mb-3 fw-bold">
        <i class="bi bi-cart fs-4"></i> Cart
    </h3>

    @if (!Model.Any())
    {
        <div class="d-flex flex-column align-items-center justify-content-center text-center py-5">
            <i class="bi bi-dropbox" style="font-size: 5rem; color: aquamarine;"></i>
            <h5 class="fw-bolder text-dark mt-3">Your Shopping Cart is Empty!</h5>
            <p class="text-muted mb-4">Looks like you haven't added anything yet.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-light text-success border border-1" style="font-weight: bold;">
                <i class="bi bi-shop me-1"></i> Start Shopping Now
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Cart Items List -->
            <div class="col-lg-8 col-md-12">
                @foreach (var item in Model)
                {
                    <div class="list-group-item p-3 border rounded shadow-sm mb-3 @(item.StockQuantity == 0 ? "opacity-50" : "")">
                        <div class="d-flex flex-column flex-md-row">
                            <!-- Product Image with Out of Stock Badge -->
                            <div class="position-relative me-md-3 mb-2 mb-md-0">
                                <img src="data:image/png;base64,@Convert.ToBase64String(item.FirstImage)"
                                     class="img-thumbnail"
                                     style="width: 100px; height: 100px; object-fit: cover;" />

                                @if (item.StockQuantity == 0)
                                {
                                    <span class="position-absolute top-0 start-0 badge bg-secondary text-white px-3 py-2 fw-bold shadow m-1"
                                          style="font-size: 0.9rem;">
                                        Out of Stock
                                    </span>
                                }
                            </div>

                            <!-- Product Details -->
                            <div class="flex-grow-1">
                                <h5 class="mb-1 text-truncate" style="max-width: 550px;">@item.Name</h5>
                                <p class="mb-1 text-muted small text-truncate" style="max-width: 550px;">@item.Description</p>

                                <!-- Pricing -->
                                <div class="d-flex flex-column mb-2">
                                    @if (item.DiscountPercentage > 0)
                                    {
                                        <p class="fw-bold text-danger mb-0" style="font-size: 1.4rem;">
                                            ₹@item.DiscountedPrice <small class="text-muted fw-light" style="font-size: 0.9rem;">(@item.DiscountPercentage% OFF)</small>
                                        </p>
                                        <small class="text-muted" style="text-decoration: line-through;">₹@item.Price</small>
                                    }
                                    else
                                    {
                                        <p class="fw-bold text-dark" style="font-size: 1.4rem;">₹@item.Price</p>
                                    }
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <!-- Stock Indicator -->
                                    <small class="@(item.StockQuantity == 0 ? "text-secondary" : item.StockQuantity > 5 ? "text-success" : "text-danger")">
                                        @(item.StockQuantity == 0 ? "Out of Stock" : item.StockQuantity > 5 ? "In Stock" : "Only " + item.StockQuantity + " left!")
                                    </small>

                                    <small class="text-muted align-baseline mb-0">Added on: @item.AddedAt.ToString("dd MMM yyyy")</small>
                                </div>

                                <hr class="mt-1" />

                                <!-- Quantity Controls & Delete Button -->
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <div>
                                        @if (item.StockQuantity == 0)
                                        {
                                            <span class="text-muted small">Unavailable</span>
                                        }
                                        else
                                        {
                                            <a asp-controller="Cart" asp-action="Update" asp-route-id="@item.ProductId" asp-route-change="-1"
                                               class="btn btn-sm btn-light text-danger border border-1">
                                                <i class="bi bi-dash-lg"></i>
                                            </a>
                                            <span class="mx-2 fw-bold">@item.Quantity</span>
                                            <a asp-controller="Cart" asp-action="Update" asp-route-id="@item.ProductId" asp-route-change="1"
                                               class="btn btn-sm btn-light text-success border border-1">
                                                <i class="bi bi-plus-lg"></i>
                                            </a>
                                        }
                                    </div>

                                    <!-- Remove Button -->
                                    <a asp-controller="Cart" asp-action="Update" asp-route-id="@item.ProductId" asp-route-change="-@item.Quantity"
                                       class="btn btn-sm btn-light text-danger border border-1">
                                        <i class="bi bi-trash"></i> Remove
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4 col-md-12">
                <div class="card shadow-sm p-3">
                    <h5 class="mb-1 fw-bold">Cart Summary</h5>
                    <hr class="my-1">

                    @if (!inStockItems.Any())
                    {
                        <div class="d-flex justify-content-center align-items-center mt-3" style="height: 100px;">
                            <p class="text-muted text-center" style="font-size: 0.95rem;">
                                No items in stock available for checkout.
                            </p>
                        </div>
                    }
                    else
                    {
                        <p class="d-flex justify-content-between my-2">
                            <span>Total Items:</span> <strong>@inStockItems.Sum(x => x.Quantity)</strong>
                        </p>
                        <p class="d-flex justify-content-between">
                            <span>Total Price:</span>
                            <strong class="text-success">
                                ₹@inStockItems.Sum(x => x.Quantity * (x.DiscountedPrice > 0 ? x.DiscountedPrice : x.Price))
                            </strong>
                        </p>
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-light text-success border border-1 w-100 mt-2 fw-bold">
                            <i class="bi bi-credit-card-2-front"></i> Proceed to Checkout
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>